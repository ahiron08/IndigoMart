# IndigoMart Backend Environment Variables
# Copy this file to `.env` and fill in your values.
# Do NOT commit real secrets to version control.

# --- Core ---
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed CORS origins (no spaces)
# Development: http://localhost:5173
# Production: https://indigomart.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# --- JWT ---
# Use `openssl rand -base64 48` to generate strong secrets
JWT_ACCESS_SECRET=<your-access-secret-min-32-chars>
JWT_REFRESH_SECRET=<your-refresh-secret-min-32-chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_COOKIE_MS=900000
REFRESH_COOKIE_MS=604800000

# --- Frontend URLs ---
# Full URL for password reset links
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# --- Email (SMTP) ---
# Optional - required for password reset emails. Example: smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=IndigoMart <no-reply@indigomart.com>

# --- Cloudinary (Image Uploads) ---
# Optional - required for product/seller ID uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Shipping (Delhivery) ---
# Optional
DELHIVERY_API_KEY=

# --- UPI QR (Payment) ---
# Optional
QR_UPI_ID=indigomart@upi
QR_PAYEE_NAME=IndigoMart

# --- Semantic Search (OpenAI + Qdrant) ---
# Optional - required for semantic search features
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=indigomart_products
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ENABLE_SEMANTIC_SEARCH=false
QUERY_EXPANSION_ENABLED=false