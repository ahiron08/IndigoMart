# ============================================
# APPLICATION SETTINGS
# ============================================

NODE_ENV=production
PORT=5000

# Comma-separated list of allowed CORS origins
CLIENT_URL=https://indigomart.onrender.com

# ============================================
# DATABASE (MongoDB)
# ============================================

# MongoDB Atlas: create a database user, allow the deployment IP, and URL-encode
# special characters in the username or password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/indigomart?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION
# ============================================

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<generate-a-long-random-string-min-32-chars>
JWT_REFRESH_SECRET=<generate-a-long-random-string-min-32-chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_COOKIE_MS=900000
REFRESH_COOKIE_MS=604800000
PASSWORD_RESET_URL=https://indigomart.onrender.com/reset-password

# ============================================
# EMAIL (SMTP)
# ============================================

# Required for password-reset delivery in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=IndigoMart <no-reply@example.com>

# ============================================
# CLOUDINARY (Image Storage)
# ============================================

# All three must be provided together.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# CHECKOUT & SHIPPING
# ============================================

# Delhivery API: Get your API key from the Delhivery partner portal.
# Leave empty to use default shipping calculations (fallback mode).
DELHIVERY_API_KEY=

# UPI ID for QR Code payments (e.g., yourname@upi, 9999999999@paytm, etc.)
QR_UPI_ID=indigomart@upi
QR_PAYEE_NAME=IndigoMart

# ============================================
# SEMANTIC SEARCH (Optional)
# ============================================

# OpenAI API key for generating product embeddings.
# Leave empty to disable semantic search.
OPENAI_API_KEY=

# Qdrant vector database URL and API key.
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=indigomart_products

# Embedding model configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Set to 'false' to disable semantic search
ENABLE_SEMANTIC_SEARCH=true
# Set to 'false' to disable query expansion
QUERY_EXPANSION_ENABLED=true