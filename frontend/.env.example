# IndigoMart Frontend Environment Variables
# Copy this file to `.env.local` for local development.
# For Vercel, add these in the Vercel project dashboard → Settings → Environment Variables.
# Do NOT commit real secrets to version control.

# Backend API URL
# Local development: http://localhost:5000
# Production: https://indigomart-api.onrender.com
#
# IMPORTANT: In production (Vercel), this MUST be set to your Render backend URL.
# If left unset, API requests fall back to "/api" (relative to the Vercel domain)
# and will be proxied via vercel.json rewrites to the Render backend.
VITE_API_URL=http://localhost:5000
