# Backend API URL (production deployments)
# Set this to the deployed backend URL, e.g. https://indigomart-api.onrender.com
# If not set, the frontend will use /api (same-origin proxy)
VITE_API_URL=

# Used only by the Vite development proxy. Browser requests should use /api.
VITE_API_PROXY_TARGET=http://localhost:5000